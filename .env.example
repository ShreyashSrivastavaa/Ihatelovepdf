# -----------------------------------------------------------------------------
# ihatelovepdf - Environment Variables Example
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development overrides.
# Since ihatelovepdf processes 100% of PDFs client-side in the browser,
# no backend credentials, databases, or cloud storage keys are required.
# -----------------------------------------------------------------------------

# Contact Form Submissions (Optional - Web3Forms Access Key)
# Default public key is provided for dev/testing.
NEXT_PUBLIC_WEB3FORMS_KEY=44e3c9b7-e4a7-43f8-8c76-0b23246e96f9

# Google Analytics Measurement ID (Optional - e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Strict Linting Toggle (true / false)
STRICT_LINT=true
