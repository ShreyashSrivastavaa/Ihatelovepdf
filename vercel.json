    },
    {
      "source": "/crop-resize",
      "destination": "/crop",
      "permanent": true
    },
    {
      "source": "/guides/how-to-ocr-scanned-pdf-free",
      "destination": "/guides/how-to-ocr-scanned-pdf-offline",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ihatelovepdf.com"
        }
      ],
      "destination": "https://www.ihatelovepdf.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://ihatelovepdf.com https://www.ihatelovepdf.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://ihatelovepdf.com https://www.ihatelovepdf.com https://www.googletagmanager.com https://api.web3forms.com https://vercel.live https://*.vercel.live; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' https://ihatelovepdf.com https://www.ihatelovepdf.com https://www.googletagmanager.com https://api.web3forms.com https://vercel.live https://*.vercel.live; style-src 'self' 'unsafe-inline' https:; style-src-elem 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https: https://ihatelovepdf.com https://www.ihatelovepdf.com; worker-src 'self' blob:; manifest-src 'self' https://ihatelovepdf.com https://www.ihatelovepdf.com; frame-src 'self' https://vercel.live https://*.vercel.live; connect-src 'self' data: blob: https://api.web3forms.com https://www.google-analytics.com https://*.google-analytics.com https://vercel.live https://*.vercel.live wss://*.pusher.com; object-src 'none'; frame-ancestors 'self' https://vercel.live https://*.vercel.live;"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(self)"
        }
      ]
    }
  ]
}
